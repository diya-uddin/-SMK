:root {
    --bg-color: #f4f1ea; /* สีพื้นหลังเหมือนกระดาษถนอมสายตา */
    --text-color: #2c2c2c;
    --accent-color: #b54933; /* สีส้มอิฐแนวกีฬาบาส */
    --font-heading: 'Pridi', serif;
    --font-body: 'Sarabun', sans-serif;
}

body {
    margin: 0;
    padding: 0;
    background-color: #e5e0d8; /* สีฉากหลังนอกหนังสือ */
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    font-family: var(--font-body);
    color: var(--text-color);
}

/* ตัวหนังสือ (หน้ากระดาษ) */
.book-container {
    background-color: var(--bg-color);
    width: 100%;
    max-width: 800px; /* ขนาดสูงสุดบน Desktop/iPad */
    min-height: 85vh;
    margin-top: 20px;
    padding: 40px 20px;
    box-sizing: border-box;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    position: relative;
}

/* หน้าปก */
.cover-page {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
}
.cover-page h1 {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    margin-bottom: 10px;
    letter-spacing: 2px;
}
.cover-page img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    margin: 30px 0;
    filter: grayscale(20%); /* ปรับรูปให้ดูคลาสสิกขึ้น */
}
.btn-open {
    padding: 12px 30px;
    font-size: 1.2rem;
    background-color: transparent;
    border: 2px solid var(--text-color);
    cursor: pointer;
    font-family: var(--font-heading);
    transition: 0.3s;
}
.btn-open:hover {
    background-color: var(--text-color);
    color: var(--bg-color);
}

/* หน้าสารบัญและเนื้อหาบท */
.chapter-page, .toc-page {
    padding: 20px;
}
.chapter-header {
    text-align: center;
    margin-bottom: 40px;
}
.chapter-number {
    font-family: var(--font-heading);
    color: var(--accent-color);
    font-size: 1.2rem;
    letter-spacing: 3px;
}
.chapter-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin: 10px 0;
}
.chapter-image {
    width: 100%;
    margin-bottom: 30px;
}
.chapter-content {
    font-size: 1.1rem;
    line-height: 1.8;
    text-align: justify;
}

/* Navigation */
.navigation {
    width: 100%;
    max-width: 800px;
    display: flex;
    justify-content: space-between;
    padding: 20px;
    box-sizing: border-box;
}
.navigation.hidden {
    display: none;
}
.navigation button {
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: 1rem;
    cursor: pointer;
    color: var(--text-color);
}

/* Responsive สำหรับมือถือ */
@media (max-width: 600px) {
    .book-container {
        margin-top: 0;
        min-height: 100vh;
        box-shadow: none;
    }
}
